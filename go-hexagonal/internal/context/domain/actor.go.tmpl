// Package domain — file actor.go
//
// PURPOSE
//   The Actor: the authenticated identity on whose behalf an operation runs.
//   It is the SINGLE parameter every app/usecase/repository method takes for
//   "who is doing this and what may they touch" — never a bare tenantID, never
//   pulled from context.Context. Inbound adapters build it from protocol-specific
//   sources (HTTP headers, gRPC metadata, JWT, session) and pass it explicitly.
//
// THIS TEMPLATE IS DELIBERATELY MINIMAL — Actor here is just {id}. Authorization
//   models vary too much to guess. Before adding fields, answer the questions in
//   the `add_context` hint and copy the matching block from there:
//
//     • Is there a tenant / org / workspace?   → add  tenantID TenantID  + getter,
//       require it in NewActor, and have repositories scope on actor.TenantID().
//     • Are there roles / permissions?          → add  roles []string  (simple RBAC:
//       AddRole/HasRole) or a typed permission set with a Can(Permission) predicate.
//     • Is there a sub-tenant grouping?         → add  teamID / groupID  (TeamID typed),
//       e.g. for "members of team X within org Y".
//     • Is the actor a human, a service, or both? → add an actorKind enum if the
//       domain treats service callers differently (skip rate limits, broader scope…).
//
//   Keep every new field unexported and expose narrow predicate getters, never the
//   slice/map itself — so no caller can mutate the authorization state.
package domain

import "github.com/google/uuid"

// ActorID is the typed identifier for an authenticated actor.
//
// Format: UUIDv7 as string — time-ordered, DB-friendly (see TenantID doc).
type ActorID string

// NewActorID generates a new time-ordered UUIDv7 ActorID. Delete this if actor
// ids come from an external IdP rather than being minted here.
func NewActorID() ActorID {
	return ActorID(uuid.Must(uuid.NewV7()).String())
}

// Domain errors for Actor — package-level vars so tests can use errors.Is.
// Add ErrActorUnauthorized / ErrActorTenantRequired / etc. as the model grows
// (see the `add_context` hint).
var (
	ErrActorNotFound   = NewError("ACTOR_NOT_FOUND", "actor not found")
	ErrActorIDRequired = NewError("ACTOR_ID_REQUIRED", "actor id is required")
)

// Actor represents the authenticated identity performing an action.
// Extend with the fields your authorization model needs — see the file header
// and the `add_context` hint for ready-made blocks (tenant, roles, team, kind).
type Actor struct {
	id ActorID
}

// NewActor creates a validated Actor. Add the parameters and checks your model
// requires (e.g. a tenantID that must be non-empty) — see the hint.
func NewActor(id ActorID) (*Actor, error) {
	if id == "" {
		return nil, ErrActorIDRequired
	}
	return &Actor{id: id}, nil
}

// --- Getters ---

func (a *Actor) ID() ActorID { return a.id }
