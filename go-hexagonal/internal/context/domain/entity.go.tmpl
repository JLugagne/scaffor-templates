// Package domain — file {{ .Entity | lower }}.go
//
// PURPOSE
//   The {{ .Entity }} aggregate: its typed identifier, its struct, its constructor,
//   its invariant-enforcing setters, and its domain errors. This is the heart of
//   the bounded context — everything else (repositories, app services, handlers)
//   exists to load, mutate and persist this type.
//
// WHAT GOES HERE
//   - {{ .Entity }}ID                — the typed identifier (string-backed UUIDv7)
//   - {{ .Entity }}                  — the struct, ALL FIELDS UNEXPORTED
//   - New{{ .Entity }}(...)          — the only validated constructor (enforces invariants)
//   - Reconstitute{{ .Entity }}(...) — rebuilds from trusted DB rows, NO validation
//   - getters / setters              — read via getters, mutate ONLY via setters that validate
//   - Err{{ .Entity }}...            — one package-level var per distinct invariant violation
//
// WHAT DOES NOT GO HERE
//   - persistence, SQL, transactions       → outbound/<adapter>/
//   - orchestration across aggregates       → app/
//   - HTTP/gRPC/CLI shapes                  → inbound/, pkg/{{ .Context }}/http|grpc/
//   - cross-aggregate pure rules / policies → domain/services/
//
// The scaffold deliberately leaves this almost empty. Generated CRUD bodies were
// removed because they forced a shape that rarely survives contact with a real
// domain. Fill it from the `add_domain_entity` hint, which carries condensed,
// copy-pasteable examples and the questions you must answer first (does this
// entity have a name? a status? money? a parent? which fields are mutable?).
package domain

import (
	"time"

	"github.com/google/uuid"
)

// {{ .Entity }}ID is the typed identifier for {{ .Entity }}.
//
// Format: UUIDv7 as string. UUIDv7 is time-ordered (the first 48 bits are a
// Unix-ms timestamp) so rows sort naturally by creation order in DB indexes —
// better insert locality than UUIDv4 and no need for a separate created_at sort.
// Always use New{{ .Entity }}ID (or domain constructors that call it) — never
// generate ad-hoc UUIDs in adapters.
type {{ .Entity }}ID string

// New{{ .Entity }}ID generates a new time-ordered UUIDv7 {{ .Entity }}ID.
// Must is used because uuid.NewV7 only errors if crypto/rand is unavailable —
// at that point the process cannot function anyway.
func New{{ .Entity }}ID() {{ .Entity }}ID {
	return {{ .Entity }}ID(uuid.Must(uuid.NewV7()).String())
}

// Domain errors for {{ .Entity }}.
//
// Declare one package-level var per distinct invariant violation. Each must have
// a stable UPPER_SNAKE code (consumed by inbound adapters to map HTTP/gRPC status)
// and a human-readable message. Tests assert specific failure modes with errors.Is.
// See the `add_domain_entity` hint for examples (XXX_NAME_REQUIRED, XXX_AMOUNT_NEGATIVE, ...).
var (
	Err{{ .Entity }}NotFound = NewError("{{ .Entity | upper }}_NOT_FOUND", "{{ .Entity | lower }} not found")
)

// {{ .Entity }} is the domain aggregate.
//
// ALL FIELDS ARE UNEXPORTED — read via getters, mutate ONLY via setters that
// enforce invariants. This is what makes "an invalid {{ .Entity }} cannot exist"
// true: there is no code path that bypasses validation. Use typed value objects
// (domain.Money, domain.{{ .Entity }}Status, …) rather than raw primitives wherever
// the value has rules of its own. See the hint for a worked example.
type {{ .Entity }} struct {
	id        {{ .Entity }}ID
	createdAt time.Time
	updatedAt time.Time
	// Add one unexported field per domain attribute. The hint shows the pattern.
}

// New{{ .Entity }} creates a validated {{ .Entity }}. All construction goes through
// here so invariants are always enforced. Add the required parameters and the
// validation as you define the entity's fields — see the hint.
func New{{ .Entity }}() (*{{ .Entity }}, error) {
	now := time.Now()
	return &{{ .Entity }}{
		id:        New{{ .Entity }}ID(),
		createdAt: now,
		updatedAt: now,
	}, nil
}

// Reconstitute{{ .Entity }} rebuilds a {{ .Entity }} from a trusted source (the DB).
// It performs NO validation — inputs are assumed valid because they were valid
// when persisted. Repository adapters call this from their row-scan path; without
// it, FindByID/List cannot return rebuilt aggregates.
//
// Add every field, in the same order the repository's Scan fills them, e.g.:
//
//	func Reconstitute{{ .Entity }}(id {{ .Entity }}ID, name string, createdAt, updatedAt time.Time) *{{ .Entity }} {
//	    return &{{ .Entity }}{id: id, name: name, createdAt: createdAt, updatedAt: updatedAt}
//	}
func Reconstitute{{ .Entity }}(id {{ .Entity }}ID, createdAt, updatedAt time.Time) *{{ .Entity }} {
	return &{{ .Entity }}{id: id, createdAt: createdAt, updatedAt: updatedAt}
}

// --- Getters ---

func (e *{{ .Entity }}) ID() {{ .Entity }}ID      { return e.id }
func (e *{{ .Entity }}) CreatedAt() time.Time     { return e.createdAt }
func (e *{{ .Entity }}) UpdatedAt() time.Time     { return e.updatedAt }

