// Package app — file config.go (the App struct itself)
//
// PURPOSE
//   App is the application service for this bounded context: one struct that
//   implements every entity's usecase interfaces (Commands + Queries). It holds
//   the outbound ports (repositories, publishers, the UnitOfWork, domain services)
//   as unexported fields, injected at startup via Set<X> setters called from the
//   wire_<entity>.go files. No globals, ever.
//
// HOW IT GROWS
//   - `add_app_service`  adds  app/<entity>.go  with the entity's methods and a
//     Set<Entity>Repo setter — then you add the matching field below by hand.
//   - `add_publisher_adapter`  adds a Set<Entity>Publisher setter — add that field too.
//   One App, many entities: methods are prefixed with the entity name so they
//   never collide (Create<Entity>, PlaceOrder, …).
//
// SCOPING
//   App methods take `actor *domain.Actor` and pass it straight through to the
//   repositories. They never accept a bare tenantID — the actor IS the scope.
package app

import "log/slog"

// App is the application service for this bounded context. Add one unexported
// field per outbound dependency as you scaffold entities — the matching setter is
// generated for you by `add_app_service` / `add_publisher_adapter`. Example:
//
//	type App struct {
//	    logger *slog.Logger
//	    orderRepo      orderrepo.OrderRepository
//	    orderPublisher orderpub.OrderPublisher
//	    uow            uow.UnitOfWork
//	    pricing        services.Pricing
//	}
type App struct {
	logger *slog.Logger
}

// New creates an App. The constructor takes only process-level dependencies
// (logger, clock, …). Outbound adapters are injected afterwards via the Set<X>
// setters, from the wire_<entity>.go files — keep it that way so wiring stays
// per-entity and testable.
func New(logger *slog.Logger) *App {
	return &App{
		logger: logger,
	}
}
