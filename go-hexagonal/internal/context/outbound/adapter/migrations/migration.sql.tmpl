-- Every statement must be idempotent (IF NOT EXISTS / IF EXISTS) so re-running
-- the migration suite on an already-migrated database is safe. Use native UUID
-- for every id/<entity>_id column.
--
-- Example:
--   CREATE TABLE IF NOT EXISTS books (
--       id         UUID PRIMARY KEY,
--       tenant_id  UUID NOT NULL,
--       created_at TIMESTAMPTZ NOT NULL,
--       updated_at TIMESTAMPTZ NOT NULL
--   );
--   CREATE INDEX IF NOT EXISTS books_tenant_id_idx ON books (tenant_id);
