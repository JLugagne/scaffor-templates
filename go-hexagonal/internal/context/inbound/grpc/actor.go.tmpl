package grpc

import (
	"context"

	"{{ .ModulePath }}/internal/{{ .Context }}/domain"

	"google.golang.org/grpc/metadata"
)

// ActorFromContext builds a *domain.Actor from gRPC metadata — the boundary
// where "who is calling" enters the system. The default below trusts an
// `x-actor-id` metadata header, which is the safe default behind a trusted
// upstream / service mesh. Extend it to match your domain.Actor (tenant, roles,
// team, …) — see domain/actor.go and the `add_context` hint.
//
// Pick ONE auth method when you flesh this out:
//
//   Header-based (trusted upstream / service mesh) — what's wired below:
//     md, _ := metadata.FromIncomingContext(ctx)
//     ids := md.Get("x-actor-id"); require non-empty; domain.NewActor(domain.ActorID(ids[0])).
//     (Add `x-tenant-id` → domain.TenantID and a 2-arg NewActor once Actor has a tenant.)
//
//   JWT (authorization metadata):
//     read md.Get("authorization"), strip "Bearer ", validate signature against the
//     issuer/secret from config, extract 'sub' as ActorID (and 'tenant_id' etc.).
//
//   mTLS peer identity:
//     peer.FromContext(ctx) + the client cert SAN/CN → ActorID.
func ActorFromContext(ctx context.Context) (*domain.Actor, error) {
	md, ok := metadata.FromIncomingContext(ctx)
	if !ok {
		return nil, domain.ErrActorIDRequired
	}
	ids := md.Get("x-actor-id")
	if len(ids) == 0 || ids[0] == "" {
		return nil, domain.ErrActorIDRequired
	}
	return domain.NewActor(domain.ActorID(ids[0]))
}
