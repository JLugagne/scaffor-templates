// Setup{{ .Entity }} registers HTTP query routes for {{ .Entity }}.
// Called from queries.SetupRouter (which is called from inbound/http.SetupRouter).
func Setup{{ .Entity }}(router *mux.Router, httpSvc HTTPService) {
	svc := {{ .Entity }}Svc{HTTPService: httpSvc, App: httpSvc.App}
	router.HandleFunc("/api/v1/tenants/{tenantID}/{{ .Entity | lower }}s/{id}", svc.getByID).Methods(http.MethodGet)
	router.HandleFunc("/api/v1/tenants/{tenantID}/{{ .Entity | lower }}s", svc.list).Methods(http.MethodGet)
	for _, fn := range {{ .Entity | lower }}QueriesActions {
		fn(router, svc)
	}
}

