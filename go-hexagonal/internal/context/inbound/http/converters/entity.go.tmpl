// Package converters — file {{ .Entity | lower }}.go ({{ .Entity }} HTTP <-> domain mapping)
//
// PURPOSE
//   Translate between the public HTTP DTOs (pkg/{{ .Context }}/http/v1) and the domain
//   type. Two directions:
//     - ToPublic{{ .Entity }} / ToPublic{{ .Entity }}List — domain → response (uses getters,
//       since domain fields are unexported)
//     - To{{ .Entity }}Domain — request → a validated domain entity (calls New{{ .Entity }})
//   This is also the place to keep the wire format stable while the domain evolves
//   (rename a domain field without touching the JSON).
//
// THE BODIES ARE SKELETONS. Fill them from the `add_http_converter` hint, which
//   shows the field-mapping rules (typed IDs → string(...), time.Time → RFC3339,
//   Money → amount/currency split, enums → their string form).
package converters

import (
	"time"

	"{{ .ModulePath }}/internal/{{ .Context }}/domain"
	v1 "{{ .ModulePath }}/pkg/{{ .Context }}/http/v1"
)

// ToPublic{{ .Entity }} converts a domain {{ .Entity }} into an API response.
// Add one line per exposed field — see the add_http_converter hint.
func ToPublic{{ .Entity }}(item *domain.{{ .Entity }}) v1.{{ .Entity }}Response {
	return v1.{{ .Entity }}Response{
		ID:        string(item.ID()),
		CreatedAt: item.CreatedAt().Format(time.RFC3339),
	}
}

// ToPublic{{ .Entity }}List converts a ListResult into a paginated API response.
func ToPublic{{ .Entity }}List(result *domain.ListResult[*domain.{{ .Entity }}]) v1.{{ .Entity }}ListResponse {
	items := make([]v1.{{ .Entity }}Response, len(result.Items))
	for i, item := range result.Items {
		items[i] = ToPublic{{ .Entity }}(item)
	}
	return v1.{{ .Entity }}ListResponse{
		Items:      items,
		NextCursor: result.NextCursor,
	}
}

// To{{ .Entity }}Domain builds a new domain {{ .Entity }} from a create request.
// Pass the request fields to New{{ .Entity }} in the constructor's argument order,
// converting primitives to domain value types first — see the add_http_converter hint.
func To{{ .Entity }}Domain(req v1.Create{{ .Entity }}Request) (*domain.{{ .Entity }}, error) {
	return domain.New{{ .Entity }}()
}
