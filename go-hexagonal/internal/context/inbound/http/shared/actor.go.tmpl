package shared

import (
	"context"
	"net/http"
	"strings"

	"{{ .ModulePath }}/internal/{{ .Context }}/domain"
)

// ActorFromRequest builds a *domain.Actor from an HTTP request.
//
// This is the boundary where "who is calling" enters the system. The default
// here is deliberately minimal — it trusts an X-Actor-ID header. That is the
// safe default behind a service mesh / API gateway (Istio, Linkerd, …) where an
// upstream trusted component has already authenticated the caller.
//
// EXTEND THIS to match your Actor (see domain/actor.go and the `add_context` hint):
//
//   • Tenant / org / workspace scope — read it and pass it to NewActor:
//       tenantID := domain.TenantID(strings.TrimSpace(r.Header.Get("X-Tenant-ID")))
//       if tenantID == "" { return nil, domain.ErrActorTenantRequired }
//       actor, err := domain.NewActor(actorID, tenantID)
//
//   • Roles (comma-separated header):
//       for _, role := range strings.Split(r.Header.Get("X-Roles"), ",") {
//           if v := strings.TrimSpace(role); v != "" { actor.AddRole(v) }
//       }
//
//   • Team / group id, actor kind (human vs service), etc. — same pattern.
//
// FOR INTERNET-FACING SERVICES, replace header trust with JWT validation or a
// session lookup — raw headers are forgeable by anyone with network access.
func ActorFromRequest(ctx context.Context, r *http.Request) (*domain.Actor, error) {
	actorID := domain.ActorID(strings.TrimSpace(r.Header.Get("X-Actor-ID")))
	if actorID == "" {
		return nil, domain.ErrActorIDRequired
	}
	return domain.NewActor(actorID)
}
