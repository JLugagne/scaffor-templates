// {{ .Entity }}App is the interface required by {{ .Entity }} command handlers.
// It combines Commands and Queries because update needs read-before-write
// (fetch current state, apply patch, save). The *app.App implements both.
type {{ .Entity }}App interface {
	{{ .Entity | lower }}uc.{{ .Entity }}Commands
	{{ .Entity | lower }}uc.{{ .Entity }}Queries
}

// {{ .Entity }}Svc handles {{ .Entity }} command HTTP requests.
type {{ .Entity }}Svc struct {
	HTTPService
	App {{ .Entity }}App
}

// {{ .Entity | lower }}ActionRegistrar registers a single action route on the router.
//
// Each file generated by `add_http_action` appends one registrar via init():
//
//	func init() {
//	    {{ .Entity | lower }}CommandsActions = append({{ .Entity | lower }}CommandsActions, func(r *mux.Router, s {{ .Entity }}Svc) {
//	        r.HandleFunc("/api/v1/.../action", s.action).Methods(http.MethodPost)
//	    })
//	}
//
// Setup{{ .Entity }} iterates this slice — no manual wiring needed.
type {{ .Entity | lower }}ActionRegistrar func(r *mux.Router, s {{ .Entity }}Svc)

var {{ .Entity | lower }}CommandsActions []{{ .Entity | lower }}ActionRegistrar

// Setup{{ .Entity }} registers HTTP command routes for {{ .Entity }}.
// Called from commands.SetupRouter (which is called from inbound/http.SetupRouter).
func Setup{{ .Entity }}(router *mux.Router, httpSvc HTTPService) {
	svc := {{ .Entity }}Svc{HTTPService: httpSvc, App: httpSvc.App}
	router.HandleFunc("/api/v1/tenants/{tenantID}/{{ .Entity | lower }}s", svc.create).Methods(http.MethodPost)
	{{- if ne .EntityHasActions "true" }}
	router.HandleFunc("/api/v1/tenants/{tenantID}/{{ .Entity | lower }}s/{id}", svc.update).Methods(http.MethodPut)
	router.HandleFunc("/api/v1/tenants/{tenantID}/{{ .Entity | lower }}s/{id}", svc.delete).Methods(http.MethodDelete)
	{{- end }}
	for _, fn := range {{ .Entity | lower }}CommandsActions {
		fn(router, svc)
	}
}

func (s {{ .Entity }}Svc) create(w http.ResponseWriter, r *http.Request) {
	actor, err := shared.ActorFromRequest(r.Context(), r)
	if err != nil {
		shared.WriteErrorJSON(w, http.StatusUnauthorized, "UNAUTHORIZED", err.Error())
		return
	}

	var req v1.Create{{ .Entity }}Request
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		shared.WriteErrorJSON(w, http.StatusBadRequest, "INVALID_JSON", err.Error())
		return
	}
	if err := s.Validator.Struct(req); err != nil {
		shared.WriteErrorJSON(w, http.StatusBadRequest, "VALIDATION_FAILED", err.Error())
		return
	}

	_ = actor
	// TODO(scaffolding): convert `req` into the domain-type argument list expected by
	// s.App.Create{{ .Entity }} (use converters.To{{ .Entity }}Domain), call the usecase
	// with (r.Context(), actor, ...), then encode the response via converters.ToPublic{{ .Entity }}
	// and shared.WriteJSON(w, http.StatusCreated, resp). Map domain errors to HTTP status
	// via shared.WriteDomainError (or equivalent) — never leak raw error strings.
	// Required before any POST {{ .Entity | lower }} test passes — handler currently
	// returns 501 regardless of input.
	w.WriteHeader(http.StatusNotImplemented)
}

