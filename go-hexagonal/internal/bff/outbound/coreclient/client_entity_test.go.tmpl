// TestClient_Get{{ .Entity }}_ContractShape asserts that the wire shape produced
// by Get{{ .Entity }} matches the core handler's expected request: HTTP method,
// URL path including the path parameter, and Authorization bearer header.
//
// TODO(scaffolding): expand to cover every method on the {{ .Entity }} client.
func TestClient_Get{{ .Entity }}_ContractShape(t *testing.T) {
	t.Parallel()

	const wantToken = "bearer-token"
	const want{{ .PathParamName | title }} = "example"

	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if got := r.Method; got != http.MethodGet {
			t.Errorf("method: got %s, want GET", got)
		}
		if got := r.Header.Get("Authorization"); got != "Bearer "+wantToken {
			t.Errorf("authorization header: got %q, want %q", got, "Bearer "+wantToken)
		}
		// TODO(scaffolding): assert r.URL.Path matches the expected pattern for {{ .Entity }}.
		w.Header().Set("Content-Type", "application/json")
		_ = json.NewEncoder(w).Encode(v1.{{ .Entity }}Response{})
	}))
	defer srv.Close()

	c := coreclient.New(srv.URL, srv.Client())
	if _, err := c.Get{{ .Entity }}(context.Background(), wantToken, want{{ .PathParamName | title }}); err != nil {
		t.Fatalf("Get{{ .Entity }}: %v", err)
	}
}

// TestClient_{{ .Entity }}_HTTPErrorPropagated asserts non-2xx responses become *coreclient.HTTPError.
func TestClient_{{ .Entity }}_HTTPErrorPropagated(t *testing.T) {
	t.Parallel()

	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		http.Error(w, `{"error":"not found"}`, http.StatusNotFound)
	}))
	defer srv.Close()

	c := coreclient.New(srv.URL, srv.Client())
	_, err := c.Get{{ .Entity }}(context.Background(), "tok", "missing")
	if err == nil {
		t.Fatalf("expected error for 404 response")
	}
	httpErr, ok := err.(*coreclient.HTTPError)
	if !ok {
		t.Fatalf("expected *coreclient.HTTPError, got %T: %v", err, err)
	}
	if httpErr.Status != http.StatusNotFound {
		t.Errorf("status: got %d, want %d", httpErr.Status, http.StatusNotFound)
	}
}
