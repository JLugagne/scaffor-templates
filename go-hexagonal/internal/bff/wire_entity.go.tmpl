package bff

import (
	"context"

	"{{ .ModulePath }}/internal/bff/app"
	"{{ .ModulePath }}/internal/bff/inbound/http/commands"
	"{{ .ModulePath }}/internal/bff/inbound/http/queries"
)

func init() {
	RegisterWire(wire{{ .Entity }})
}

// wire{{ .Entity }} registers the BFF inbound routes for the {{ .Entity }} entity.
//
// TODO(scaffolding): if the entity is read-only, drop the commands.Setup line.
// If it has no GET endpoints, drop the queries.Setup line.
func wire{{ .Entity }}(_ context.Context, _ *app.App, deps WireDeps) {
	queries.Setup{{ .Entity }}Routes(deps.HTTPMux, deps.CoreClient, deps.Session)
	commands.Setup{{ .Entity }}Routes(deps.HTTPMux, deps.CoreClient, deps.Session, deps.CmdValidator)
}
